{
  "manifest_version": 3,
  "name": "Application Tracker — Assistente",
  "version": "0.2.0",
  "description": "Avalia a vaga enquanto você navega, preenche formulários sozinho com seu perfil e CV, completa perguntas abertas com IA e registra suas candidaturas.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Application Tracker",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
