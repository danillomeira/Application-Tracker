# API, worker e beat (o robô do LinkedIn roda na máquina do usuário, não aqui).
# Build a partir da raiz do repositório: docker build -f infra/Dockerfile.backend .
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates fontconfig fonts-dejavu-core libgraphite2-3 libharfbuzz0b libfreetype6 libpng16-16t64 libssl3 \
    && rm -rf /var/lib/apt/lists/*
# tectonic (LaTeX) para gerar os PDFs dos currículos
RUN curl --proto '=https' --tlsv1.2 -fsSL https://drop-sh.fullyjustified.net | sh && mv tectonic /usr/local/bin/
COPY --from=ghcr.io/astral-sh/uv:0.8.15 /uv /usr/local/bin/uv

WORKDIR /app/backend
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY backend/ ./
COPY templates/ /app/templates/
RUN uv sync --frozen --no-dev

RUN useradd --create-home tracker && mkdir -p /app/data/storage && chown -R tracker /app/data
USER tracker
ENV PATH="/app/backend/.venv/bin:$PATH" API_HOST=0.0.0.0 LATEX_CMD=tectonic
EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && tracker-api"]
